{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "aion2dps",
  "version": "0.3.2",
  "identifier": "com.aion2dps.meter",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Passive AION 2 damage meter",
    "longDescription": "Shows AION 2 combat damage from the game's network packets. It never reads game memory.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installerHooks": "./windows/hooks.nsh" }
    }
  }
}
